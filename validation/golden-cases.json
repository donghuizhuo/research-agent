        "has_citation": true,
        "has_freshness": true
      }
    },
    {
      "id": "exact-lookup-info-200",
      "query": "INFO 200",
      "expect": {
        "status": "ok",
        "has_citation": true
      }
    },
    {
      "id": "department-search-cse",
      "query": "CSE courses",
      "expect": {
        "status": "ok",
        "has_results": true
      }
    },
    {
      "id": "keyword-search",
      "query": "programming",
      "expect": {
        "status": "ok"
      }
    },
    {
      "id": "natural-language-search",
      "query": "introductory programming course",
      "expect": {
        "status": "ok"
      }
    },
    {
      "id": "missing-field",
